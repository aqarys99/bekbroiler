Options -Indexes -ExecCGI

<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

AddType image/webp .webp

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

<FilesMatch "\.(php\d?|phtml|phar)$">
    RemoveHandler .php .phtml .phar
    <IfModule mod_php.c>
        SetHandler none
    </IfModule>
</FilesMatch>

# Документы: PDF и картинки открываются в браузере, Office-файлы скачиваются (ARCHITECTURE §6.3)
<FilesMatch "\.(docx?|xlsx?|pptx?)$">
    <IfModule mod_headers.c>
        Header set Content-Disposition "attachment"
    </IfModule>
</FilesMatch>
