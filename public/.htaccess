Options -Indexes
DirectoryIndex index.php

# Статические файлы отдаёт сам Apache: базовые заголовки (остальные шлёт приложение)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PDF.js: модули и wasm должны отдаваться с правильным типом (модульные скрипты это проверяют)
<IfModule mod_mime.c>
    AddType application/javascript .mjs
    AddType application/wasm .wasm
    AddType application/octet-stream .bcmap .pfb
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Точечные файлы не отдаём
    RewriteRule (^|/)\.(?!well-known) - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
